{
  "title": "Robot Joint Inspection API",
  "uid": "robot-inspection-api",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Inspection Requests by Risk Level",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (risk_level) (rate(inspection_requests_total[5m]))",
          "legendFormat": "{{risk_level}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Inspection Requests by Defect Severity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (severity) (rate(inspection_requests_total[5m]))",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Inspection Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(inspection_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(inspection_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(inspection_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Error Rate by Stage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (stage) (rate(inspection_errors_total[5m]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total Inspections Processed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(inspection_requests_total)" }
      ]
    },
    {
      "id": 6,
      "title": "Median Model Confidence",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(model_confidence_bucket[15m])) by (le))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Total Errors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(inspection_errors_total)" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "red", "value": 1 }
      ] } }, "overrides": [] }
    }
  ]
}